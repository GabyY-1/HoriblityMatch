<script>

document.addEventListener("DOMContentLoaded", async () => {


    /* =========================
       AUTHENTIFICATION
    ========================= */

    const {
        data: {
            session
        }
    } = await supabaseClient.auth.getSession();


    if (!session) {

        window.location.href =
            "../pages/connexion.html";

        return;

    }


    const {
        data: staff,
        error: staffError
    } = await supabaseClient
        .from("staff")
        .select("id, role")
        .eq("id", session.user.id)
        .maybeSingle();


    if (staffError || !staff) {

        await supabaseClient.auth.signOut();

        window.location.href =
            "../pages/connexion.html";

        return;

    }


    /* =========================
       NAVIGATION
    ========================= */

    const navButtons =
        document.querySelectorAll(
            ".settings-nav button"
        );


    const sections =
        document.querySelectorAll(
            ".settings-section"
        );


    navButtons.forEach(button => {

        button.addEventListener(
            "click",
            () => {

                const target =
                    button.dataset.section;


                navButtons.forEach(item => {

                    item.classList.remove(
                        "active"
                    );

                });


                button.classList.add(
                    "active"
                );


                sections.forEach(section => {

                    section.style.display =
                        section.id ===
                        `section-${target}`
                            ? "block"
                            : "none";

                });

            }
        );

    });


    sections.forEach(
        (section, index) => {

            if (index !== 0) {

                section.style.display =
                    "none";

            }

        }
    );


    /* =========================
       SAUVEGARDE LOCALE V1
    ========================= */

    const settingFields = [

        "studioName",
        "studioSlogan",
        "studioDescription",
        "studioEmail",
        "studioLanguage",
        "homeTitle",
        "homeSubtitle",
        "showProjects",
        "showPartners",
        "showAnnouncements",
        "contactEmail",
        "contactWebsite",
        "contactText",
        "discord",
        "youtube",
        "instagram",
        "x",
        "animations",
        "showDates",
        "seoTitle",
        "seoDescription",
        "seoKeywords"

    ];


    const STORAGE_KEY =
        "horiblitimatch_settings";


    function getSettings() {

        const saved =
            localStorage.getItem(
                STORAGE_KEY
            );


        if (!saved) {
            return {};
        }


        try {

            return JSON.parse(saved);

        } catch {

            return {};

        }

    }


    function loadSettings() {

        const settings =
            getSettings();


        settingFields.forEach(id => {

            const element =
                document.getElementById(id);


            if (!element) {
                return;
            }


            if (
                element.type ===
                "checkbox"
            ) {

                if (
                    typeof settings[id] ===
                    "boolean"
                ) {

                    element.checked =
                        settings[id];

                }

                return;

            }


            if (
                settings[id] !==
                undefined
            ) {

                element.value =
                    settings[id];

            }

        });

    }


    function saveSettings() {

        const settings = {};


        settingFields.forEach(id => {

            const element =
                document.getElementById(id);


            if (!element) {
                return;
            }


            if (
                element.type ===
                "checkbox"
            ) {

                settings[id] =
                    element.checked;

            } else {

                settings[id] =
                    element.value.trim();

            }

        });


        localStorage.setItem(
            STORAGE_KEY,
            JSON.stringify(settings)
        );


        const status =
            document.getElementById(
                "saveStatus"
            );


        status.classList.add(
            "visible"
        );


        setTimeout(() => {

            status.classList.remove(
                "visible"
            );

        }, 2500);

    }


    loadSettings();


    document
        .getElementById("saveSettings")
        .addEventListener(
            "click",
            saveSettings
        );


    /* =========================
       DECONNEXION
    ========================= */

    document
        .getElementById("logout")
        .addEventListener(
            "click",
            async () => {

                await supabaseClient.auth.signOut();

                window.location.href =
                    "../pages/connexion.html";

            }
        );


    document
        .getElementById("logoutAll")
        .addEventListener(
            "click",
            async () => {

                const confirmed =
                    confirm(
                        "Voulez-vous vraiment vous déconnecter ?"
                    );


                if (!confirmed) {
                    return;
                }


                await supabaseClient.auth.signOut();

                window.location.href =
                    "../pages/connexion.html";

            }
        );

});

</script>

