<style>

    body.staff-page {
        background:
            radial-gradient(
                circle at 20% 10%,
                rgba(108, 92, 231, 0.08),
                transparent 30%
            ),
            #0b0d12;
    }

    .settings-page {
        width: min(1200px, calc(100% - 40px));
        margin: 0 auto;
        padding: 55px 0 100px;
    }

    .settings-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 40px;
    }

    .settings-title h1 {
        margin: 8px 0;
    }

    .settings-title p {
        margin: 0;
        color: #9ca3b4;
    }

    .settings-grid {
        display: grid;
        grid-template-columns: 240px 1fr;
        gap: 22px;
        align-items: start;
    }

    .settings-nav,
    .settings-card {
        background: #12151d;
        border: 1px solid #242936;
        border-radius: 18px;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.2);
    }

    .settings-nav {
        padding: 10px;
        position: sticky;
        top: 20px;
    }

    .settings-nav button {
        width: 100%;
        border: 0;
        background: transparent;
        color: #aeb5c5;
        padding: 13px 14px;
        border-radius: 11px;
        text-align: left;
        cursor: pointer;
        font: inherit;
        transition: 0.2s ease;
    }

    .settings-nav button:hover,
    .settings-nav button.active {
        background: #1b1f2a;
        color: #ffffff;
    }

    .settings-content {
        display: grid;
        gap: 18px;
    }

    .settings-card {
        padding: 28px;
    }

    .settings-card h2 {
        margin: 0 0 7px;
    }

    .settings-card > p {
        margin: 0 0 25px;
        color: #8f96a8;
    }

    .settings-fields {
        display: grid;
        gap: 18px;
    }

    .settings-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .settings-field {
        display: grid;
        gap: 8px;
    }

    .settings-field label {
        color: #dce0e8;
        font-size: 14px;
        font-weight: 600;
    }

    .settings-field input,
    .settings-field textarea,
    .settings-field select {
        width: 100%;
        box-sizing: border-box;
        background: #0d1016;
        color: #ffffff;
        border: 1px solid #292f3c;
        border-radius: 11px;
        padding: 13px 14px;
        outline: none;
        font: inherit;
        transition: 0.2s ease;
    }

    .settings-field textarea {
        min-height: 130px;
        resize: vertical;
    }

    .settings-field input:focus,
    .settings-field textarea:focus,
    .settings-field select:focus {
        border-color: #6c5ce7;
        box-shadow: 0 0 0 3px rgba(108, 92, 231, 0.1);
    }

    .settings-help {
        color: #747c8d;
        font-size: 13px;
    }

    .settings-switch {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 16px;
        background: #0e1117;
        border: 1px solid #252b37;
        border-radius: 12px;
    }

    .settings-switch strong {
        display: block;
        margin-bottom: 4px;
    }

    .settings-switch span {
        color: #7f8798;
        font-size: 13px;
    }

    .switch {
        position: relative;
        width: 48px;
        height: 26px;
        flex: 0 0 auto;
    }

    .switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .switch-slider {
        position: absolute;
        inset: 0;
        background: #292f3b;
        border-radius: 50px;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .switch-slider::before {
        content: "";
        position: absolute;
        width: 20px;
        height: 20px;
        left: 3px;
        top: 3px;
        background: #ffffff;
        border-radius: 50%;
        transition: 0.2s ease;
    }

    .switch input:checked + .switch-slider {
        background: #6c5ce7;
    }

    .switch input:checked + .switch-slider::before {
        transform: translateX(22px);
    }

    .settings-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 25px;
    }

    .save-status {
        display: none;
        align-items: center;
        padding: 10px 14px;
        border-radius: 10px;
        background: rgba(50, 205, 120, 0.08);
        border: 1px solid rgba(50, 205, 120, 0.2);
        color: #75e0a5;
        font-size: 13px;
    }

    .save-status.visible {
        display: flex;
    }

    .danger-card {
        border-color: rgba(255, 80, 80, 0.2);
    }

    .danger-card h2 {
        color: #ff8585;
    }

    @media (max-width: 800px) {

        .settings-grid {
            grid-template-columns: 1fr;
        }

        .settings-nav {
            position: static;
            display: flex;
            overflow-x: auto;
        }

        .settings-nav button {
            white-space: nowrap;
            width: auto;
        }

        .settings-row {
            grid-template-columns: 1fr;
        }

        .settings-top {
            align-items: flex-start;
            flex-direction: column;
        }

    }

</style>
